# Keep machine-local data and caches inside the ignored task2 directories.
HW3_TASK2_DATA_ROOT=./data/calvin
HW3_TASK2_OUTPUT_ROOT=./outputs
HF_HOME=./.cache/hf
HF_LEROBOT_HOME=./.cache/hf/lerobot
TEMP=./.cache/hf/tmp
TMP=./.cache/hf/tmp
SWANLAB_LOG_DIR=./swanlog

# Use "offline" until `swanlab login` has been completed.
SWANLAB_MODE=offline
SWANLAB_PROJECT=hw3-calvin-act

# Optional cloud logging credentials. Never commit the real value.
# SWANLAB_API_KEY=
